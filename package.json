{
  "name": "opencode-codex-quota",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin to monitor ChatGPT Codex subscription quota and trigger on-demand rate-limit resets",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McAlvaro/opencode-codex-quota.git"
  },
  "homepage": "https://github.com/McAlvaro/opencode-codex-quota#readme",
  "bugs": {
    "url": "https://github.com/McAlvaro/opencode-codex-quota/issues"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "codex",
    "quota",
    "tui",
    "plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opentui/core": "latest",
    "@opentui/solid": "latest",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^3.25.0"
  }
}
